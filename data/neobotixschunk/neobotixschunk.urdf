        <!box size="0.03 0.01 0.08"/>
        <box size="0.03 0.005 0.08"/>
      </geometry>
    </collision-->
  </link>
  <link name="grasping_frame">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="grasping_frame_joint" type="fixed">
    <parent link="gripper_palm_link"/>
    <child link="grasping_frame"/>
    <origin rpy="0 0 0" xyz="0 0 0.1139"/>
    <!--origin rpy="0 0 0" xyz="0 0 0.2463"/-->
  </joint>
  <joint name="laserscanner_front_joint" type="fixed">
    <axis xyz="0 1 0"/>
    <origin rpy="3.14 0 0" xyz="0.244 0 0.141"/>
    <parent link="base_link"/>
    <child link="laserscanner_front_link"/>
  </joint>
  <link name="laserscanner_front_link" type="laser">
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="-1.57 0 3.14" xyz="0 0 -0.12"/>
      <geometry>
        <mesh filename="/data/neobotixschunk/mp_500/meshes/SICK-S300.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Yellow"/>
    </visual>
    <collision>
      <origin rpy="-1.57 0 3.14" xyz="0 0 -0.12"/>
      <geometry>
        <mesh filename="/data/neobotixschunk/mp_500/meshes/SICK-S300.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- Base Link -->
  <gazebo reference="base_footprint">
    <material value="Gazebo/Grey"/>
  </gazebo>
  <gazebo reference="base_link">
    <gravity>true</gravity>
    <kp>1000.0</kp>
    <kd>10.0</kd>
    <mu1>200</mu1>
    <mu2>100</mu2>
    <fdir1>0.5 0 0</fdir1>
    <maxVel>10.0</maxVel>
    <minDepth>0.0005</minDepth>
  </gazebo>
  <!-- Left Wheel -->
  <gazebo reference="wheel_left_link">
    <mu1 value="300.0"/>
    <mu2 value="100.0"/>
    <kp value="8000.0"/>
    <kd value="1460.0"/>
    <fdir1 value="0.5 0 0"/>
  </gazebo>
  <!-- Right Wheel -->
  <gazebo reference="wheel_right_link">
    <mu1 value="300.0"/>
    <mu2 value="100.0"/>
    <kp value="8000.0"/>
    <kd value="1460.0"/>
    <fdir1 value="0.5 0 0"/>
  </gazebo>
  <!-- Castor -->
  <gazebo reference="hanger">
    <kp>8000.0</kp>
    <kd>1460.0</kd>
    <mu1>0.5</mu1>
    <mu2>0.2</mu2>
    <fdir1>1 0 0</fdir1>
    <maxVel>3.0</maxVel>
    <minDepth>0.00</minDepth>
    <gravity>true</gravity>
  </gazebo>
  <gazebo reference="arm_base_link">
    <gravity>true</gravity>
    <self_collide>false</self_collide>
    <material value="Gazebo/Black"/>
  </gazebo>
  <gazebo reference="arm_1_link">
    <gravity>true</gravity>
    <self_collide>false</self_collide>
    <material value="Gazebo/Grey"/>
  </gazebo>
  <gazebo reference="arm_2_link">
    <gravity>true</gravity>
    <self_collide>false</self_collide>
    <material value="Gazebo/Black"/>
  </gazebo>
  <gazebo reference="arm_3_link">
    <gravity>true</gravity>
    <self_collide>false</self_collide>
    <material value="Gazebo/Grey"/>
  </gazebo>
  <gazebo reference="arm_4_link">
    <gravity>true</gravity>
    <self_collide>false</self_collide>
    <material value="Gazebo/Black"/>
  </gazebo>
  <gazebo reference="arm_5_link">
    <gravity>true</gravity>
    <self_collide>false</self_collide>
    <material value="Gazebo/Grey"/>
  </gazebo>
  <gazebo reference="arm_6_link">
    <gravity>true</gravity>
    <self_collide>false</self_collide>
    <material value="Gazebo/Black"/>
  </gazebo>
  <gazebo reference="arm_7_link">
    <gravity>true</gravity>
    <self_collide>false</self_collide>
    <material value="Gazebo/Grey"/>
  </gazebo>
  <gazebo reference="gripper_podest_link">
    <gravity>true</gravity>
    <self_collide>false</self_collide>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="gripper_palm_link">
    <gravity>true</gravity>
    <self_collide>true</self_collide>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="gripper_finger_left_link">
    <gravity>true</gravity>
    <self_collide>false</self_collide>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="gripper_finger_right_link">
    <gravity>true</gravity>
    <self_collide>false</self_collide>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="laserscanner_front_link">
    <material value="Gazebo/Grey"/>
  </gazebo>
  <gazebo reference="laserscanner_front_link">
    <sensor name="rplidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-1.48353</min_angle>
            <max_angle>1.48353</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.05</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <!-- Noise parameters based on published spec for Hokuyo laser
                   achieving "+-30mm" accuracy at range < 10m.  A mean of 0.0m and
                   stddev of 0.01m will put 99.7% of samples within 0.03m of the true
                   reading. -->
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_laser.so" name="lidar_1_link">
        <topicName>lidar_1/scan_filtered</topicName>
        <frameName>lidar_1_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
  <transmission name="wheel_left_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wheel_left_joint" type="revolute">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="wheel_left_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>7</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="wheel_right_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wheel_right_joint" type="revolute">
